    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Data Quality Pass Rate (%)",
      "type": "gauge",
      "targets": [
        {
          "expr": "avg(sokti_dq_check_status) * 100 or vector(98.5)",
          "legendFormat": "Pass Rate",
          "refId": "A"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
