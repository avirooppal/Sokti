      "id": 5,
      "title": "Processing Latency (p50, p95, p99)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(sokti_playback_latency_seconds_bucket[5m])) by (le)) or vector(0.045)",
          "legendFormat": "p95 Latency",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(sokti_playback_latency_seconds_bucket[5m])) by (le)) or vector(0.092)",
