# ==============================================================================
# Sokti OTT Data Platform - Environment Configuration
# ==============================================================================

# Project Name
COMPOSE_PROJECT_NAME=sokti

# PostgreSQL (OLTP)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sokti
POSTGRES_HOST=localhost
POSTGRES_PORT=15432

# pgvector (Vector Store)
PGVECTOR_USER=postgres
PGVECTOR_PASSWORD=postgres
PGVECTOR_DB=vector_store
PGVECTOR_HOST=localhost
PGVECTOR_PORT=15433

# MongoDB (Content Metadata)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin
MONGO_PORT=27018
MONGO_HOST=localhost
MONGO_DATABASE=sokti_metadata

# Kafka
KAFKA_HOST=localhost
KAFKA_BROKER_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_BOOTSTRAP_SERVERS_INTERNAL=kafka:29092

# Schema Registry
SCHEMA_REGISTRY_PORT=8081
SCHEMA_REGISTRY_URL=http://localhost:8081

# Kafka Connect / Debezium
KAFKA_CONNECT_PORT=8083
KAFKA_CONNECT_URL=http://localhost:8083

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_DB=sokti
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=sokti_pass
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# MinIO (S3-compatible Object Storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9002
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9001
MINIO_DEFAULT_BUCKETS=sokti-raw,sokti-lake,sokti-checkpoints

# Apache Airflow
AIRFLOW_PORT=8085
AIRFLOW_WWW_USER_USERNAME=admin
AIRFLOW_WWW_USER_PASSWORD=admin
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=False

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
