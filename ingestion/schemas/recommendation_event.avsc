{
  "type": "record",
  "name": "RecommendationEvent",
  "namespace": "com.sokti.ott.events",
  "doc": "Telemetry event for recommendation rails impression and clicks",
  "fields": [
    {"name": "event_id", "type": "string"},
    {"name": "event_type", "type": {
      "type": "enum",
      "name": "RecommendationEventType",
      "symbols": ["recommendation_impression", "recommendation_click"]
    }},
    {"name": "schema_version", "type": "string", "default": "1.0.0"},
    {"name": "user_id", "type": "string"},
    {"name": "session_id", "type": "string"},
    {"name": "device_id", "type": "string"},
    {"name": "model_version", "type": "string"},
    {"name": "recommended_content_ids", "type": {"type": "array", "items": "string"}},
    {"name": "clicked_content_id", "type": ["null", "string"], "default": null},
    {"name": "position_index", "type": "int", "default": 0},
    {"name": "event_time", "type": "string"},
    {"name": "ingestion_time", "type": "string"}
  ]
}
